name: '{{ etcd_node.name }}'
data-dir: '/var/lib/etcd/{{ etcd_node.name }}.etcd'
listen-peer-urls: 'http://{{ etcd_node.ip }}:2380'
listen-client-urls: 'http://{{ etcd_node.ip }}:2379,http://127.0.0.1:2379'
initial-advertise-peer-urls: 'http://{{ etcd_node.ip }}:2380'
advertise-client-urls: 'http://{{ etcd_node.ip }}:2379'
initial-cluster: '{% for member in etcd_cluster %}{{ member.name }}=http://{{ member.ip }}:2380{% if not loop.last %},{% endif %}{% endfor %}'
initial-cluster-token: '{{ etcd_initial_cluster_token }}'
initial-cluster-state: '{{ etcd_initial_cluster_state }}'
